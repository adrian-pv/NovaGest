# Copiar a .env y completar. NUNCA subir .env al repositorio.
# Conexion a la base (la base la administra el equipo de DBA)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=novagest
DB_USER=
DB_PASSWORD=

# Clave para firmar los JWT (HS256): minimo 256 bits (32 caracteres o mas)
JWT_SECRET=

# Perfil de Spring (dev, test o prod); docker compose usa dev si se deja vacio
SPRING_PROFILES_ACTIVE=dev

# Carpeta donde se guardan los comprobantes de pago (en Docker es un volumen)
COMPROBANTES_DIR=comprobantes

# Clave de los usuarios de demostracion (solo perfil dev), minimo 8 caracteres y sin comillas
DEMO_PASSWORD=

# Origenes del navegador autorizados a llamar a la API, separados por coma (sin comodin ni barra final).
# En desarrollo: el frontend de Vite. En produccion dejar vacio si el frontend se publica en el mismo origen que la API.
CORS_ORIGINS=http://localhost:5173

# Solo detras de un proxy (Nginx): ver README, "Despliegue detras de Nginx". En desarrollo dejar vacio.
# FORWARD_HEADERS=native
# PROXIES_CONFIANZA: expresion regular de la direccion DEL PROXY (nunca ".*": la aplicacion no arranca)
# PROXIES_CONFIANZA=127\.0\.0\.1
