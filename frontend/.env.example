# Copiar a .env.local si hace falta cambiar algo. Nada de aquí es secreto: todo lo que empieza con VITE_
# queda visible en el navegador.

# Dirección base de la API. Vacío = mismo origen (proxy de Vite en desarrollo, Nginx en producción).
VITE_API_BASE_URL=

# Solo desarrollo: a dónde envía Vite las llamadas /api (el backend de Spring).
VITE_API_PROXY=http://localhost:8080
