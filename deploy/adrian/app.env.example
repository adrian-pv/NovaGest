# Variables propias de NovaGest. En el servidor queda en /opt/tramites/<entorno>/app.env (permisos 600).
# setup-server.sh lo crea con una clave aleatoria. Nunca subir el archivo real al repositorio.

# Clave para firmar los JWT (HS256): mínimo 32 caracteres. Una DISTINTA por entorno.
# Generar con:  openssl rand -base64 48
JWT_SECRET=CAMBIAR
