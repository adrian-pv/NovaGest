# Variables propias de NovaGest. En el servidor queda en /opt/tramites/<entorno>/app.env (permisos 600).
# setup-server.sh lo crea con una clave aleatoria. Nunca subir el archivo real al repositorio.

# Clave para firmar los JWT (HS256): mínimo 32 caracteres. Una DISTINTA por entorno.
# Generar con:  openssl rand -base64 48
JWT_SECRET=CAMBIAR

# Flyway migra en el esquema tramites y crea los objetos a nombre del dueño (tramites_owner en pruebas,
# tramites_prod_owner en producción), así los privilegios por defecto del DBA alcanzan a la app.
# El usuario y la clave del migrador van en .env (FLYWAY_USER / FLYWAY_PASSWORD), no aquí: compose.yaml
# los pasa como SPRING_FLYWAY_USER / SPRING_FLYWAY_PASSWORD y pisaría lo que se ponga en este archivo.
SPRING_FLYWAY_SCHEMAS=tramites
SPRING_FLYWAY_DEFAULT_SCHEMA=tramites
SPRING_FLYWAY_INIT_SQLS=SET ROLE CAMBIAR
