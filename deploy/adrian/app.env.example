# Variables propias de NovaGest. En el servidor queda en /opt/tramites/<entorno>/app.env (permisos 600).
# setup-server.sh lo crea con una clave aleatoria. Nunca subir el archivo real al repositorio.

# Clave para firmar los JWT (HS256): mínimo 32 caracteres. Una DISTINTA por entorno.
# Generar con:  openssl rand -base64 48
JWT_SECRET=CAMBIAR

# Cabeceras del proxy (Nginx, tarjeta 45). Con native, Spring usa X-Forwarded-For/Proto/Host/Port SOLO si
# la petición viene de PROXIES_CONFIANZA: la puerta de enlace de la red Docker del entorno, por donde llega Nginx.
# Es una regex: escapar los puntos y nunca usar .* (el backend se niega a arrancar si es demasiado amplia).
#   staging:    172\.30\.11\.1   (red 172.30.11.0/24)
#   production: 172\.30\.12\.1   (red 172.30.12.0/24)
# Comprobar con: docker network inspect <proyecto>_default --format '{{(index .IPAM.Config 0).Gateway}}'
FORWARD_HEADERS=native
PROXIES_CONFIANZA=172\.30\.12\.1
