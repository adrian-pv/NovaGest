# Rutas de UN entorno de NovaGest, comunes al acceso privado y al origen del
# tunel. Se renderiza en /etc/nginx/snippets/novagest-<entorno>-rutas.conf y la
# incluye cada server, que antes fija $novagest_proto.
#
# El backend ya emite nosniff, X-Frame-Options, Referrer-Policy,
# Permissions-Policy, CSP de la API, Cache-Control y HSTS (bajo HTTPS); aqui no
# se repiten en las rutas proxeadas. Las cabeceras del frontend van en "/".

# Limite de borde por IP; el backend aplica ademas el suyo y el bloqueo por cuenta.
location = /api/auth/login {
    limit_req zone=novagest_login burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:${BACKEND_PORT};
    include /etc/nginx/snippets/novagest-proxy-headers.conf;
}

# proxy_pass sin sufijo conserva /api y la ruta completa solicitada.
location /api/ {
    proxy_pass http://127.0.0.1:${BACKEND_PORT};
    include /etc/nginx/snippets/novagest-proxy-headers.conf;
}

location = /actuator/health {
    proxy_pass http://127.0.0.1:${BACKEND_PORT};
    include /etc/nginx/snippets/novagest-proxy-headers.conf;
}

# El resto de /actuator no se publica.
location /actuator/ {
    return 404;
}

# Frontend compilado (frontend/dist). Mientras no exista la carpeta responde 404.
location / {
    root ${FRONTEND_ROOT};
    try_files $uri $uri/ /index.html;

    # Vacío en el acceso privado (HTTP): Nginx no envía una cabecera con valor vacío.
    add_header Strict-Transport-Security $novagest_hsts always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    # Propuesta para la tarjeta 42 (CSP del frontend); ajustar con desarrollo.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
}

# Archivos de Vite con hash en el nombre: cache larga, y 404 si no existen (sin
# fallback a index.html, que devolveria HTML con 200 a un pedido de JS o CSS).
location /assets/ {
    root ${FRONTEND_ROOT};
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    # Vacío en el acceso privado (HTTP): Nginx no envía una cabecera con valor vacío.
    add_header Strict-Transport-Security $novagest_hsts always;
    add_header X-Content-Type-Options "nosniff" always;
}

location = /index.html {
    root ${FRONTEND_ROOT};
    add_header Cache-Control "no-cache" always;
    # Vacío en el acceso privado (HTTP): Nginx no envía una cabecera con valor vacío.
    add_header Strict-Transport-Security $novagest_hsts always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
}
